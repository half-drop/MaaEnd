+/// Explicitly remove the system tray icon before application exit.
+///
+/// Tauri's `TrayIcon` is reference-counted, and MXU keeps an additional clone
+/// in the static `TRAY_ICON`. Static values are not dropped during normal
+/// process teardown, so without taking this clone the underlying tray icon may
+/// never reach its final `Drop` while the application is alive. On Windows that
+/// prevents the tray implementation from sending `NIM_DELETE`, leaving a stale
+/// notification-area icon until Explorer refreshes it.
+pub fn cleanup_tray(app: &AppHandle) {
+    let tray = TRAY_ICON
+        .get()
+        .and_then(|tray_mutex| tray_mutex.lock().ok())
+        .and_then(|mut guard| guard.take());
+
+    if let Some(tray) = tray {
+        let id = tray.id().clone();
+
+        // Tauri also keeps a clone in its resource table. Remove that clone so
+        // dropping our static clone can release the underlying platform icon.
+        if let Some(registered_tray) = app.remove_tray_by_id(&id) {
+            drop(registered_tray);
+        }
+
+        drop(tray);
+        log::info!("System tray icon removed before exit");
+    }
+}
