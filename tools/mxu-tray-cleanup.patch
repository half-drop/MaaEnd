+                // Remove the tray while the event loop is still alive so the
+                // platform tray implementation can unregister it cleanly.
+                tauri::RunEvent::ExitRequested { .. } => {
+                    tray::cleanup_tray(app_handle);
+                }
+                // 退出前收尾遥测（结束 Session 与悬挂 Transaction 并 flush）
